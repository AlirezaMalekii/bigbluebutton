# Copy to .deploy.env and adjust ( .deploy.env is gitignored )
DEPLOY_USER=root
DEPLOY_HOST=78.157.39.51
DEPLOY_PORT=3698
REMOTE_DIR=/root/dev/bigbluebutton

# Optional: explicit private key path (if not using default ~/.ssh or ssh-agent)
# SSH_IDENTITY=$HOME/.ssh/id_rsa

# GitHub Actions secrets map to these env vars at deploy time:
#   DEPLOY_SSH_PRIVATE_KEY  → loaded via ssh-agent (webfactory/ssh-agent)
#   DEPLOY_HOST, DEPLOY_PORT, DEPLOY_USER, DEPLOY_REMOTE_DIR (as REMOTE_DIR)
