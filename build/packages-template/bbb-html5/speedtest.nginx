# SafeMeet meeting-server speed test (same origin as /html5client).
# Exact / prefix-priority locations so the static html5 alias does not capture them.
# Payload is created once by bbb-html5 after-install at /var/bigbluebutton/speedtest/payload.bin
#
# Upload cannot use `return 204`: that runs in rewrite phase and does not read the
# POST body. On HTTP/2 nginx then RST_STREAMs after ~64KB and the browser hangs.
# Proxy to a local sink that reads the body, then 204.

location = /html5client/speedtest/ping {
    gzip off;
    default_type text/plain;
    add_header Cache-Control "no-store, no-cache, must-revalidate";
    add_header Pragma "no-cache";
    return 204;
}

location = /html5client/speedtest/upload {
    gzip off;
    client_max_body_size 64m;
    client_body_buffer_size 256k;
    client_body_timeout 30s;
    proxy_request_buffering on;
    proxy_http_version 1.1;
    proxy_set_header Connection close;
    proxy_set_header Host $host;
    proxy_set_header Content-Length $content_length;
    proxy_set_header Content-Type $content_type;
    proxy_pass http://127.0.0.1:31417/;
    proxy_read_timeout 30s;
    proxy_send_timeout 30s;
}

location = /html5client/speedtest/download {
    gzip off;
    gzip_static off;
    etag off;
    if_modified_since off;
    expires -1;
    add_header Cache-Control "no-store, no-cache, must-revalidate";
    add_header Pragma "no-cache";
    add_header Content-Type "application/octet-stream";
    add_header X-Content-Type-Options "nosniff";
    sendfile on;
    tcp_nopush on;
    default_type application/octet-stream;
    alias /var/bigbluebutton/speedtest/payload.bin;
}
